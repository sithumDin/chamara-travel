# Copy this file to .env.local and fill in real values.
# Nothing in this file is committed with real secrets — .env.local is gitignored.

# --- Email (Gmail SMTP via nodemailer) --------------------------------------
# The Gmail address inquiry/review emails are sent from and to.
GMAIL_USER=sithumdinujaya9@gmail.com

# A Google App Password for GMAIL_USER (requires 2-Step Verification enabled):
# https://myaccount.google.com/apppasswords
# Never commit this value — it grants full account access. Local dev only
# reads it from .env.local (gitignored); set it in your host's environment
# variables for production.
GMAIL_PASS=amllrnhuxcabzkhq

# --- Analytics & Tracking ---------------------------------------------------
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion ID, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion action labels from Google Ads (Tools > Conversions > your action > "Use event snippet")
# The part after the slash in "AW-XXXXXXXXX/AbCdEfGhIjK"
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_INQUIRY=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_WHATSAPP=
